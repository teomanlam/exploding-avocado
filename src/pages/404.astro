---
import '../styles/global.css';
import 'flag-icons/css/flag-icons.min.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 — Page not found · Teoman Lam</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline src="/theme.js"></script>
    <style>
      .not-found {
        min-height: calc(100vh - 128px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding: 3rem 1.5rem;
        text-align: center;
      }
      .not-found h1 {
        margin: 0;
        font-size: clamp(6rem, 22vw, 14rem);
        font-weight: 800;
        line-height: 0.85;
        letter-spacing: -0.06em;
      }
      .not-found p {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
      }
      @media (max-width: 860px) {
        .not-found { min-height: calc(100vh - 20px); }
      }
    </style>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"></div>
    <div class="panel">
      <div class="not-found">
        <span class="badge"><span class="status-dot" aria-hidden="true"></span>Error</span>
        <h1>404</h1>
        <p>This page doesn't exist.</p>
        <a class="cta" href="/">← Back home</a>
      </div>
    </div>
  </body>
</html>
