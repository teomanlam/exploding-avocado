---
import '../styles/global.css';
import { type Lang, type Translation, langMeta } from '../i18n/translations';
import heroFont from '@fontsource/inter-tight/files/inter-tight-latin-800-normal.woff2?url';

interface Props {
  t: Translation;
  lang: Lang;
}

const { t, lang } = Astro.props;
const siteUrl = 'https://teolam.com';
const canonicalUrl = `${siteUrl}${langMeta[lang].path}`;

const ogLocale: Record<Lang, string> = {
  en: 'en_GB',
  de: 'de_DE',
  fr: 'fr_FR',
  it: 'it_IT',
  ja: 'ja_JP',
  ko: 'ko_KR',
  tr: 'tr_TR',
};

const legal = lang === 'de'
  ? { privacy: '/de/datenschutz/', imprint: '/de/impressum/' }
  : { privacy: '/privacy/', imprint: '/imprint/' };
const ogImage = `${siteUrl}/og-image.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonicalUrl,
  inLanguage: lang,
  dateModified: new Date().toISOString().slice(0, 10),
  mainEntity: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Teoman Lam',
    alternateName: 'Teo',
    url: `${siteUrl}/`,
    jobTitle: 'Technical Product Owner',
    description: t.meta.description,
    worksFor: { '@type': 'Organization', name: 'BLACKROLL AG', url: 'https://www.blackroll.com' },
    sameAs: ['https://www.linkedin.com/in/teomanlam'],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Zurich',
      addressCountry: 'CH',
    },
    knowsLanguage: ['de', 'de-CH', 'en', 'tr', 'ko'],
    knowsAbout: [
      'Technical Product Ownership', 'Dataflows', 'Data Architecture', 'Process Automation',
      'Technical Project Management', 'ERP', 'EDI', 'B2B Integration', 'DACH',
    ],
    alumniOf: {
      '@type': 'EducationalOrganization',
      name: 'ZHAW Zurich University of Applied Sciences',
      url: 'https://www.zhaw.ch',
    },
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      name: 'Project Management Professional (PMP)',
      credentialCategory: 'Certification',
      recognizedBy: {
        '@type': 'Organization',
        name: 'Project Management Institute (PMI)',
        url: 'https://www.pmi.org',
      },
    },
  },
};

// Four-point sparkle used as the brand mark and decorative accent
const sparkle = 'M12 0C12.8 7.5 16.5 11.2 24 12C16.5 12.8 12.8 16.5 12 24C11.2 16.5 7.5 12.8 0 12C7.5 11.2 11.2 7.5 12 0Z';
// Flags for t.languages.items, which share the same order in every locale
const languageFlags = ['de', 'ch', 'gb', 'tr', 'kr'];
const pad = (n: number) => String(n).padStart(2, '0');
const [featured, ...pastRoles] = t.experience.items;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="Teoman Lam" />
    <meta name="keywords" content="Teoman Lam, dataflows, data structure, technical leadership, process scaling, integration, DACH, Switzerland, IT project manager, technical product owner, data analytics, EDI, B2B integration" />
    <meta name="theme-color" content="#0e0e0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ebe9e6" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline src="/theme.js"></script>
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="CH" />
    <meta name="geo.placename" content="Zurich, Switzerland" />
    <meta name="geo.position" content="47.3769;8.5417" />
    <meta name="ICBM" content="47.3769, 8.5417" />
    <link rel="preload" href={heroFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="de" href={`${siteUrl}/de/`} />
    <link rel="alternate" hreflang="fr" href={`${siteUrl}/fr/`} />
    <link rel="alternate" hreflang="it" href={`${siteUrl}/it/`} />
    <link rel="alternate" hreflang="ja" href={`${siteUrl}/ja/`} />
    <link rel="alternate" hreflang="ko" href={`${siteUrl}/ko/`} />
    <link rel="alternate" hreflang="tr" href={`${siteUrl}/tr/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Teoman Lam" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Teoman Lam" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {Object.entries(ogLocale).filter(([l]) => l !== lang).map(([_, locale]) => (
      <meta property="og:locale:alternate" content={locale} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Teoman Lam" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t.ui.skip}</a>
    <div class="panel">
      <header class="site-header">
        <a class="brand" href={langMeta[lang].path} title="Teoman Lam">
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><path d={sparkle} /></svg>
          <span>Teoman Lam</span>
        </a>
        <nav class="links" aria-label="Sections">
          <a href="#experience" title={t.nav.experience}>{t.nav.experience}</a>
          <a href="#skills" title={t.nav.skills}>{t.nav.skills}</a>
          <a href="#education" title={t.nav.education}>{t.nav.education}</a>
          <a href="#certifications" title={t.nav.certifications}>{t.nav.certifications}</a>
          <a href="#others" title={t.nav.others}>{t.nav.others}</a>
          <a href="#contact" class="nav-contact" title={t.nav.contact}>[ {t.nav.contact} ]</a>
        </nav>
        <div class="header-tools">
          <div class="lang-switcher">
            {Object.entries(langMeta).map(([code, meta]) => (
              <a href={meta.path} class:list={['lang-btn', { active: code === lang }]} aria-label={meta.name} title={meta.name}>
                <img class="flag" src={`/flags/${meta.flag}.svg`} width="20" height="15" alt="" />
              </a>
            ))}
          </div>
          <button type="button" class="theme-toggle" data-theme-toggle aria-label={t.ui.toggleTheme} title={t.ui.toggleTheme}>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" /></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg>
          </button>
          <details class="mobile-menu">
            <summary>{t.ui.menu}</summary>
            <nav aria-label="Sections">
              <a href="#experience">{t.nav.experience}</a>
              <a href="#skills">{t.nav.skills}</a>
              <a href="#education">{t.nav.education}</a>
              <a href="#certifications">{t.nav.certifications}</a>
              <a href="#others">{t.nav.others}</a>
              <a href="#contact" class="nav-contact">[ {t.nav.contact} ]</a>
            </nav>
          </details>
        </div>
      </header>

      <main id="main">
      <section class="hero">
        <div class="hero-deco" aria-hidden="true">
          <div class="dots hero-dots"></div>
          <div class="shape ring-lg"></div>
          <div class="shape ring-dashed"></div>
          <div class="shape diamond-outline"></div>
          <div class="shape diamond-fill"></div>
          <div class="shape capsule"></div>
          <div class="shape hline"></div>
          <div class="shape vline"></div>
          <svg class="cross cross-tl" viewBox="0 0 14 14"><path d="M7 0v14M0 7h14" /></svg>
          <svg class="cross cross-tr" viewBox="0 0 14 14"><path d="M7 0v14M0 7h14" /></svg>
          <svg class="cross cross-bl" viewBox="0 0 14 14"><path d="M7 0v14M0 7h14" /></svg>
          <svg class="cross cross-br" viewBox="0 0 14 14"><path d="M7 0v14M0 7h14" /></svg>
          <svg class="spark spark-a" viewBox="0 0 24 24"><path d={sparkle} /></svg>
          <svg class="spark spark-b" viewBox="0 0 24 24"><path d={sparkle} /></svg>
          <svg class="spark spark-c" viewBox="0 0 24 24"><path d={sparkle} /></svg>
        </div>
        <div class="badge"><span class="status-dot" aria-hidden="true"></span>{t.hero.badge}</div>
        <h1>{t.hero.h1}</h1>
        <div class="tagline">
          {t.hero.tagline.map(para => <p>{para}</p>)}
        </div>
        <div class="hero-actions">
          <a class="cta" href="#contact" title={t.hero.cta}>{t.hero.cta}</a>
          {t.pills.map(pill => <a class="pill" href="#skills" title={pill}>{pill}</a>)}
        </div>
      </section>

      <section id="figures" class="figures">
        {t.figures.map((fig, i) => (
          <div class="figure-card">
            <span class="pill figure-tag"><span class="dot" aria-hidden="true"></span>{pad(i + 1)}</span>
            <div>
              <strong>{fig.value}</strong>
              <p>{fig.label}</p>
            </div>
          </div>
        ))}
      </section>

      <div class="keyword-band" aria-hidden="true">
        {t.pills.map((pill, i) => (
          <>
            {i > 0 && <svg class="spark" viewBox="0 0 24 24"><path d={sparkle} /></svg>}
            <span class:list={[{ outline: i % 2 === 1 }]}>{pill}</span>
          </>
        ))}
      </div>

      <section id="experience" class="section">
        <div class="section-head"><h2>{t.experience.heading}</h2><span class="section-num">[ 01 ]</span></div>
        <div class="feature">
          <div class="feature-text">
            <h3>{featured.role}</h3>
            <p class="company">{featured.company}</p>
            <div class="pill-row">
              {featured.period.split(' · ').reverse().map((part, i) => (
                <span class:list={['pill', { 'pill-fill': i === 0 }]}>{part}</span>
              ))}
            </div>
            <ul class="list">
              {featured.bullets.map(b => <li>{b}</li>)}
            </ul>
          </div>
          <div class="feature-art" aria-hidden="true">
            <svg viewBox="0 0 700 520" preserveAspectRatio="xMidYMid slice">
              <circle class="ring" cx="540" cy="150" r="60" />
              <circle class="ring ring-2" cx="540" cy="150" r="120" />
              <circle class="ring ring-3" cx="540" cy="150" r="190" />
              <path class="flow" d="M40 440 C200 440 220 280 360 280 S 470 150 540 150" />
              <path class="flow-dashed" d="M40 380 C180 380 260 420 380 400 S 560 300 680 320" />
              <path class="flow-accent" d="M210 470 L210 360 L360 280" />
              <circle class="node" cx="40" cy="440" r="5" />
              <circle class="node-hollow" cx="360" cy="280" r="6" />
              <circle class="node" cx="540" cy="150" r="8" />
              <circle class="node-accent" cx="210" cy="360" r="4" />
              <rect class="outline" x="600" y="400" width="44" height="44" transform="rotate(45 622 422)" />
              <path class="outline" d="M90 90v20M80 100h20" />
            </svg>
          </div>
        </div>
        <div class="grid grid-3">
          {pastRoles.map(item => (
            <div class="card">
              <h3>{item.role}</h3>
              <p class="company">{item.company}</p>
              <div class="pill-row">
                {item.period.split(' · ').reverse().map((part, i) => (
                  <span class:list={['pill', { 'pill-fill': i === 0 }]}>{part}</span>
                ))}
              </div>
              <ul class="list">
                {item.bullets.map(b => <li>{b}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="skills" class="section">
        <div class="section-head"><h2>{t.skills.heading}</h2><span class="section-num">[ 02 ]</span></div>
        <div class="grid grid-4">
          {t.skills.items.map(item => (
            <div class="card">
              <span class="pill">{item.title}</span>
              <ul class="list">
                {item.bullets.map(b => <li>{b}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="education" class="section">
        <div class="section-head"><h2>{t.education.heading}</h2><span class="section-num">[ 03 ]</span></div>
        <div class="grid grid-2">
          {t.education.items.map(item => (
            <div class="card">
              <h3>{item.school}</h3>
              <p class="meta">{item.period}</p>
              <span class="pill pill-fill">{item.grade}</span>
            </div>
          ))}
        </div>
      </section>

      <div class="section grid grid-2 split">
        <section id="certifications">
          <div class="section-head"><h2>{t.certifications.heading}</h2><span class="section-num">[ 04 ]</span></div>
          {t.certifications.items.map(item => (
            <div class="card">
              <h3>{item.title}</h3>
              {item.date && <span class="pill pill-fill">{item.date}</span>}
              <p class="meta">{item.body} <a class="pmi-link" href="https://www.pmi.org/" target="_blank" rel="noopener" title="Project Management Institute">PMI</a></p>
            </div>
          ))}
        </section>
        <section id="languages">
          <div class="section-head"><h2>{t.languages.heading}</h2><span class="section-num">[ 05 ]</span></div>
          <div class="card pill-cloud">
            {t.languages.items.map((item, i) => (
              <span class:list={['pill', { 'pill-fill': i < 2 }]}>
                {languageFlags[i] && <img class="flag" src={`/flags/${languageFlags[i]}.svg`} width="16" height="12" alt="" />}
                {item}
              </span>
            ))}
          </div>
        </section>
      </div>

      <section id="others" class="section">
        <div class="section-head"><h2>{t.others.heading}</h2><span class="section-num">[ 06 ]</span></div>
        <div class="grid grid-3">
          {t.others.items.map((item, i) => (
            <div class="card">
              <span class="label">{item.title}</span>
              {i === 0 ? (
                <ul class="list">
                  {item.bullets.map(b => <li>{b}</li>)}
                </ul>
              ) : (
                <div class="pill-row">
                  {item.bullets.map(b => <span class="pill">{b}</span>)}
                </div>
              )}
            </div>
          ))}
          <div id="freetime" class="card">
            <span class="label">{t.freetime.heading} [ 07 ]</span>
            <div class="pill-row">
              {t.freetime.items.map(item => <span class="pill">{item}</span>)}
            </div>
          </div>
        </div>
      </section>

      <section id="contact" class="contact">
        <div class="contact-deco" aria-hidden="true">
          <div class="dots contact-dots"></div>
          <div class="shape c-ring-1"></div>
          <div class="shape c-ring-2"></div>
          <div class="shape c-ring-3"></div>
          <div class="shape c-diamond"></div>
          <svg class="spark c-spark" viewBox="0 0 24 24"><path d={sparkle} /></svg>
        </div>
        <span class="label">[ 08 ] {t.contact.heading}</span>
        <h2>{t.contact.strong}</h2>
        <p>{t.contact.body}</p>
        <a class="cta cta-light" href="https://www.linkedin.com/in/teomanlam?originalSubdomain=ch" target="_blank" rel="noopener" title={t.contact.cta}>{t.contact.cta}</a>
      </section>
      </main>

      <footer>
        <p>© {new Date().getFullYear()} Teoman Lam — teolam.com</p>
        <p class="footer-meta">
          <span class="version">v1.1.0</span>
          <span class="divider">·</span>
          <span class="made-in">{t.footer.madeIn} <img class="flag flag-square" src="/flags/ch.svg" width="12" height="12" alt="Swiss flag" /></span>
          <span class="divider">·</span>
          <span lang="ko">서울</span> — Zürich
        </p>
        <p class="footer-legal">
          <a href={legal.privacy}>{t.footer.privacy}</a>
          <a href={legal.imprint}>{t.footer.imprint}</a>
        </p>
        <div class="footer-lang">
          {Object.entries(langMeta).map(([code, meta]) => (
            <a href={meta.path} class:list={['lang-btn', { active: code === lang }]} aria-label={meta.name} title={meta.name}>
              <img class="flag" src={`/flags/${meta.flag}.svg`} width="20" height="15" alt="" />
            </a>
          ))}
        </div>
      </footer>
    </div>
    <!-- Cloudflare Web Analytics -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "b530329b9e9b41719793a0e73d15f018"}'></script>
  </body>
</html>
